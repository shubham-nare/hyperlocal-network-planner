# Copy this file to .env and fill in real values. .env itself is gitignored.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/hyperlocal
DATABASE_URL_TEST=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/hyperlocal_test

# Optional -- defaults shown. Requires a local Ollama instance (https://ollama.com) with
# the model pulled (`ollama pull llama3.2:3b`); no API key, no per-call cost.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
